# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — server-side secret env files must NEVER be committed.
# The project intentionally versions `.env` (public Supabase publishable keys
# only). Any secret (AI provider keys, service-role keys) belongs in `.env.local`
# or the deploy platform's secret store — both ignored here. See docs/SECURITY.md.
.env.local
.env.*.local
# Staging targets live only in `.env.staging.local` (template: .env.staging.example).
.env.staging
.env.development.local
.env.production.local
.env.server
*.pem
*.key

# Supabase CLI local cache (per-machine, not part of the project)
supabase/.temp/

# Playwright e2e run output (reports, traces, screenshots) — regenerated by
# `npm run test:e2e`, never part of the project itself.
/test-results/
/playwright-report/
/blob-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Third-party benchmark drawings, and anything derived from them, are never
# committed; authorized copies are supplied locally (see
# benchmark-inputs/external-20261013/INPUTS.md).
benchmark-inputs/**/*.pdf
benchmark-inputs/**/engine-output/drawing-*
# Everything else under benchmark-inputs/ is local-only too: drawings in any
# format or case, QS measurement sheets, reference and gold files, adjudication
# records, contract tags, permissions, local registers and scoring output.
# Only each folder's public register (INPUTS.md) and the existing engine-version
# hash may be committed. Checked by scripts/benchmark/input-ignores.test.ts.
benchmark-inputs/**
!benchmark-inputs/**/
!benchmark-inputs/*/INPUTS.md
!benchmark-inputs/external-20261013/engine-output/engine-version.sha256
# E4 discovery interviews: recordings, notes, consent records, screener
# responses and the participant-code key are personal data (DPDP Act 2023) and
# never committed. Only the anonymised synthesis, docs/research/E4-SYNTHESIS.md,
# is. See docs/research/E4-INTERVIEW-GUIDE.md §1.3.
research-inputs/
# Local-only evaluations on drawings without redistribution permission.
src/lib/review/__local__/
