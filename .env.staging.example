# Cunstruct — STAGING target (template; placeholders only).
#
# Copy to `.env.staging.local` (git-ignored) and fill in values from a SEPARATE
# staging Supabase project — never the production project. Alternatively set
# the same variables in the environment (e.g. the cloud environment's secrets).
#
# Every staging command verifies these first (scripts/staging-guard.mjs) and
# refuses to run if anything is missing, malformed, or points at production:
#   npm run staging:check      verify the target, contact nothing
#   npm run dev:staging        run the app against staging
#   npm run build:staging      build the app against staging
#   npm run staging:migrate    dry run: verify + list the Stage 3–6 migrations
# See docs/staging-validation-stage3-6.md.

# Staging project ref (Supabase dashboard → Project Settings → General).
STAGING_SUPABASE_PROJECT_REF=<staging-project-ref>

# App (public values for the staging project).
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>

# Database connection string for the STAGING project (a secret — keep it only in
# `.env.staging.local` or the environment's secret store). Only these two forms
# are accepted, because for them the HOST determines the project:
#   postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres
#   postgresql://postgres.<staging-project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# SSL is always required (an sslmode weaker than "require" in the URL is ignored).
STAGING_DB_URL=postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres
