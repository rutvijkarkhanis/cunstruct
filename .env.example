# Cunstruct — CLIENT-SAFE environment (these ship to the browser).
# Copy to `.env`. Only VITE_-prefixed, public values belong here.
# NEVER put a secret (service-role key, AI provider API key) in this file or in
# `.env` — server secrets go in `.env.local` (git-ignored) or the deploy
# platform's secret store. See docs/environment-variables.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional app routing/config
VITE_APP_URL=
VITE_MAIN_URL=
VITE_IS_APP_SUBDOMAIN=

# AI drawing analysis (see docs/ai-analysis-pipeline.md). Both are booleans
# ("true"/"1"); the real security boundary is server-side RLS + admin-role
# checks in the ai-analysis edge function, NOT these flags — see the file.
# Reveals the "Use AI API" mode in BOQ review (still does nothing without the
# server-side OPENAI_API_KEY secret being set).
VITE_ANALYSIS_API_ENABLED=
# Reveals model/pricing/contract-version/force-reanalyse controls to a caller
# the SERVER separately confirms is an admin. Presentation only.
VITE_SHOW_INTERNAL_AI_CONTROLS=
